DATABASE_URL=postgres://postgres:postgres@localhost:5432/skillplatform
CORS_ORIGIN=http://localhost:5173

# Frontend URL — backend redirects here after OAuth completes
FRONTEND_URL=http://localhost:5173

# Google OAuth (create a Web client in Google Cloud Console)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT RS256 keys (multiline values; use \n for newlines)
# Generate with:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Comma-separated list of allowed Google account domains (default: vitalify.asia)
# Add personal domains here for local dev, e.g.: AUTH_ALLOWED_DOMAINS=vitalify.asia,gmail.com
AUTH_ALLOWED_DOMAINS=vitalify.asia

# Azure Blob Storage (Azurite locally; real Storage Account in Phase 7)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_SUBMISSIONS_CONTAINER=submissions
